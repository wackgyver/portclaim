# PortClaim Receiver (Omarchy / Linux). Copy to ~/.config/portclaim/usb-loom.env
# Fill from HANDOVER.omarchy.md. Do not commit a filled copy.
USB_LOOM_TOKEN=
USB_LOOM_HUB=http://192.168.0.10:27180
USB_LOOM_SELF=192.168.0.20
USB_LOOM_CLIENT_ID=
USB_LOOM_MIC_DEVICE=portclaim_mic
# Native Linux touchpad requires the hub's TP10/N1 extension + descriptor API.
# Explicit rollback: legacy (mouse-emulation backend).
USB_LOOM_TP_BACKEND=native
# No rolling debug microphone recordings in normal use.
USB_LOOM_AUDIO_PROBE=0
# Optional webcam: set only after a dedicated exclusive-caps v4l2loopback output
# named PortClaim Camera is provisioned. No default device and no auto-start.
# Example path: /dev/video42 (verify it; never point this at a physical camera).
USB_LOOM_CAMERA_OUTPUT=
# Optional read-only Storage UI: explicitly provision a dedicated restricted SSH
# alias/key/known host first. Never reuse a hub administrator/root alias.
# Empty means unconfigured; startup and Connect never access storage.
USB_LOOM_STORAGE_SSH=
# Optional separately authorized unmount-only key/alias for the SAME hub.
# Never use an administrator alias or reuse the browsing key. No auto-unmount.
USB_LOOM_STORAGE_UNMOUNT_SSH=
