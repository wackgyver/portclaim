# Copy to usb-loom.env (gitignored) or export before install.sh / Deploy-Hub.ps1
# Do not commit a filled copy.
USB_LOOM_TOKEN=
USB_LOOM_CONTROL_PORT=27180
USB_LOOM_BIND=0.0.0.0
# Webcam is disabled until the hub operator opts in. Still requires explicit
# receiver Start + private stream lease; never auto-captures at startup.
USB_LOOM_CAMERA_ENABLED=0
# Optional stable /dev/v4l/by-id/ or by-path link, configured privately on hub.
# Without a selector, exactly one USB UVC video-index0 candidate is required.
USB_LOOM_CAMERA_DEVICE=
# Pin the intended USB microphone before enabling webcam support.
# Example: DCMT USB Condenser Microphone. Replace for other hardware.
# USB_LOOM_MIC_USB_ID=31b2:0011
# A configured pin never falls back when missing/ambiguous/invalid.
# A genuinely unset pin retains legacy selection ONLY while webcam support is off.
